{
  "name": "project-crownflare",
  "private": true,
  "version": "0.0.0-b00",
  "type": "module",
  "description": "Original premium side-scrolling action roguelite — B00 foundation, NOT release art",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "audit:assets": "node tools/audit-assets/audit.mjs",
    "art:b01a:build": "node tools/art-export/build-b01a-previews.mjs",
    "art:iona:overnight:build": "node tools/art-export/build-iona-overnight.mjs",
    "art:iona:recovery:build": "python tools/art-export/build-iona-recovery.py",
    "art:iona:b01c:build": "python tools/art-export/build-iona-b01c.py",
    "art:iona:b01d:build": "python tools/art-export/build-iona-b01d.py && python tools/art-export/audit-iona-b01d.py",
    "art:iona:b01e:build": "python tools/art-export/build-iona-b01e.py && python tools/art-export/audit-iona-b01e.py",
    "audio:iona:b01e:build": "python tools/audio/generate-iona-b01e-sfx.py",
    "qa:b01a": "node tools/local-qa/b01a-visual-review.mjs",
    "qa:iona:overnight": "node tools/local-qa/iona-overnight-smoke.mjs",
    "qa:iona:recovery": "node tools/local-qa/iona-recovery-smoke.mjs",
    "qa:iona:b01c": "node tools/local-qa/iona-b01c-production-smoke.mjs",
    "qa:iona:b01d": "python tools/art-export/audit-iona-b01d.py && node tools/local-qa/iona-b01d-production-smoke.mjs",
    "qa:iona:b01e": "python tools/art-export/audit-iona-b01e.py && node tools/local-qa/iona-b01e-production-smoke.mjs",
    "qa:art:portable": "python tools/art-export/audit-iona-b01d.py && python tools/art-export/audit-iona-b01e.py && node tools/art-export/qa-art-portable.mjs",
    "qa:chrome:local": "node tools/local-qa/chrome-smoke.mjs --headed",
    "qa:controller:local": "node tools/local-qa/controller-start-smoke.mjs",
    "qa:chrome:headless": "node tools/local-qa/chrome-smoke.mjs --headless"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "playwright": "1.55.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
